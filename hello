      },
      "Year 12": {
        label: "Bring senior maths ideas together",
        tint: "#f4dfcf",
        strands: [
          ["Number", "Surds, indices, growth, numerical methods, and financial applications."],
          ["Algebra", "Functions, transformations, equations, and mathematical models."],
          ["Measurement", "Trigonometry, rates of change, units, and applications."],
          ["Space", "Vectors, coordinate geometry, proofs, and 3D reasoning."],
          ["Statistics", "Distributions, sampling, statistical claims, and data analysis."],
          ["Probability", "Conditional probability, compound events, and expected outcomes."]
        ]
      }
    };

    const strandIcons = ["№", "ƒ", "↗", "◇", "▥", "◌"];
    const homeView = document.querySelector("#home-view");
    const topicView = document.querySelector("#topic-view");
    const yearGrid = document.querySelector("#year-grid");
    const pathwayPanel = document.querySelector("#pathway-panel");
    let activeYear = "Year 7";

    function renderYears() {
      yearGrid.innerHTML = Object.entries(curriculum).map(([year, data]) => `
        <button
          class="year-card ${year === activeYear ? "selected" : ""}"
          style="--tint:${data.tint}"
          data-year="${year}"
          aria-pressed="${year === activeYear}"
        >
          <span class="year-tag">Calculora learning map</span>
          <h3>${year}</h3>
          <p>${data.label}. Open the six topic strands.</p>
        </button>
      `).join("");

      yearGrid.querySelectorAll("[data-year]").forEach(button => {
        button.addEventListener("click", () => {
          activeYear = button.dataset.year;
          renderYears();
          renderPathway();
        });
      });
    }

    function renderPathway() {
      const data = curriculum[activeYear];

      pathwayPanel.innerHTML = `
        <div class="panel-head">
          <div>
            <h3>${activeYear} learning map</h3>
            <p>${data.label} · Choose a topic to open its 30 practice questions.</p>
          </div>
          <span class="curriculum-tag">Six topic strands</span>
        </div>

        <div class="strand-grid">
          ${data.strands.map(([name, description], index) => `
            <a
              class="strand strand-topic-link"
              style="--tint:${data.tint}"
              href="?year=${encodeURIComponent(activeYear)}&topic=${encodeURIComponent(name)}"
            >
              <div class="strand-top">
                <span class="strand-icon">${strandIcons[index]}</span>
                <h4>${name}</h4>
              </div>
              <p>${description}</p>
              <span class="strand-action">
                <span>Open 30 questions</span>
                <span aria-hidden="true">↗</span>
              </span>
            </a>
          `).join("")}
        </div>`;
    }

    function simplifyFraction(numerator, denominator) {
      function gcd(a, b) {
        return b === 0 ? a : gcd(b, a % b);
      }
      const divisor = gcd(numerator, denominator);
      return `${numerator / divisor}/${denominator / divisor}`;
    }

    function numberQuestion(i, yearNumber) {
      if (yearNumber >= 10 && i % 5 === 0) {
        const base = 2 + (i % 5);
        const firstPower = 2 + (i % 3);
        const secondPower = 1 + (i % 4);
        return {
          prompt: `Simplify ${base}^${firstPower} × ${base}^${secondPower}.`,
          answer: `${base}^${firstPower + secondPower}`,
          explanation: "When multiplying powers with the same base, add the exponents."
        };
      }

      if (yearNumber >= 9 && i % 5 === 1) {
        const percent = 10 + (i % 9) * 5;
        const amount = 20 * (10 + i);
        return {
          prompt: `What is ${percent}% of ${amount}?`,
          answer: String(amount * percent / 100),
          explanation: `Convert ${percent}% to a decimal and multiply by ${amount}.`
        };
      }

      if (yearNumber >= 8 && i % 5 === 2) {
        const firstPart = 2 + (i % 4);
        const secondPart = 1 + (i % 3);
        const groupSize = 3 + i;
        const total = (firstPart + secondPart) * groupSize;
        return {
          prompt: `Share ${total} in the ratio ${firstPart}:${secondPart}. How many are in the first share?`,
          answer: String(firstPart * groupSize),
          explanation: `There are ${firstPart + secondPart} equal parts. Each part is ${groupSize}.`
        };
      }

      const operation = i % 4;

      if (operation === 0) {
        const a = 17 + i * 3;
        const b = 8 + i * 2;
        return { prompt: `Calculate ${a} + ${b}.`, answer: String(a + b), explanation: "Add the two numbers." };
      }

      if (operation === 1) {
        const b = 9 + i * 2;
        const a = b + 14 + i;
        return { prompt: `Calculate ${a} − ${b}.`, answer: String(a - b), explanation: "Subtract the second number from the first." };
      }

      if (operation === 2) {
        const a = 2 + (i % 9);
        const b = 4 + i;
        return { prompt: `Calculate ${a} × ${b}.`, answer: String(a * b), explanation: "Multiply the two numbers." };
      }

      const divisor = 2 + (i % 9);
      const quotient = 3 + i;
      return {
        prompt: `Calculate ${divisor * quotient} ÷ ${divisor}.`,
        answer: String(quotient),
        explanation: "Division reverses multiplication."
      };
    }

    function algebraQuestion(i, yearNumber) {
      if (yearNumber >= 10 && i % 3 === 0) {
        const a = 1 + (i % 6);
        const b = 2 + (i % 5);
        return {
          prompt: `Factorise x² + ${a + b}x + ${a * b}.`,
          answer: `(x + ${a})(x + ${b})`,
          explanation: `Find two numbers that multiply to ${a * b} and add to ${a + b}.`
        };
      }

      if (yearNumber >= 8 && i % 3 === 1) {
        const multiplier = 2 + (i % 7);
        const constant = 3 + i;
        return {
          prompt: `Expand ${multiplier}(x + ${constant}).`,
          answer: `${multiplier}x + ${multiplier * constant}`,
          explanation: `Multiply ${multiplier} by both terms inside the brackets.`
        };
      }

      const coefficient = 2 + (i % 7);
      const solution = 2 + (i % 10);
      const constant = 3 + ((i * 2) % 15);
      const total = coefficient * solution + constant;
      return {
        prompt: `Solve ${coefficient}x + ${constant} = ${total}.`,
        answer: `x = ${solution}`,
        explanation: `Subtract ${constant} from both sides, then divide by ${coefficient}.`
      };
    }

    function measurementQuestion(i, yearNumber) {
      if (yearNumber >= 9 && i % 3 === 2) {
        const triples = [[3, 4, 5], [5, 12, 13], [8, 15, 17]];
        const [a, b, c] = triples[(i - 1) % triples.length];
        const scale = 1 + Math.floor((i - 1) / 3);
        return {
          prompt: `A right triangle has shorter sides ${a * scale} cm and ${b * scale} cm. Find the hypotenuse.`,
          answer: `${c * scale} cm`,
          explanation: "Use Pythagoras: a² + b² = c²."
        };
      }

      if (yearNumber >= 8 && i % 3 === 1) {
        const length = 4 + i;
        const width = 2 + (i % 7);
        const height = 3 + (i % 5);
        return {
          prompt: `A cuboid is ${length} cm long, ${width} cm wide, and ${height} cm high. Find its volume.`,
          answer: `${length * width * height} cm³`,
          explanation: `Volume = length × width × height = ${length} × ${width} × ${height}.`
        };
      }

      const length = 5 + i;
      const width = 3 + (i % 9);

      if (i % 2 === 0) {
        return {
          prompt: `A rectangle is ${length} cm long and ${width} cm wide. Find its area.`,
          answer: `${length * width} cm²`,
          explanation: "Area = length × width."
        };
      }

      return {
        prompt: `A rectangle is ${length} cm long and ${width} cm wide. Find its perimeter.`,
        answer: `${2 * (length + width)} cm`,
        explanation: "Perimeter = 2 × (length + width)."
      };
    }

    function spaceQuestion(i, yearNumber) {
      if (yearNumber >= 10 && i % 5 === 0) {
        const x = 2 + i;
        const y = 3 + (i % 8);
        return {
          prompt: `Reflect the point (${x}, ${y}) across the y-axis. What are its new coordinates?`,
          answer: `(${-x}, ${y})`,
          explanation: "Reflection across the y-axis changes the sign of x and keeps y the same."
        };
      }

      if (yearNumber >= 8 && i % 2 === 0) {
        const triples = [[3, 4, 5], [5, 12, 13], [8, 15, 17]];
        const [a, b, c] = triples[(i - 1) % triples.length];
        const scale = 1 + Math.floor((i - 1) / 6);
        return {
          prompt: `A right triangle has shorter sides ${a * scale} cm and ${b * scale} cm. Find the hypotenuse.`,
          answer: `${c * scale} cm`,
          explanation: "Use Pythagoras: the square of the hypotenuse equals the sum of the squares of the other sides."
        };
      }

      const firstAngle = 35 + ((i * 3) % 50);
      const secondAngle = 40 + ((i * 7) % 50);
      return {
        prompt: `A triangle has angles of ${firstAngle}° and ${secondAngle}°. Find its third angle.`,
        answer: `${180 - firstAngle - secondAngle}°`,
        explanation: "The angles inside every triangle add up to 180°."
      };
    }

    function statisticsQuestion(i) {
      const middle = 12 + i;
      const values = [middle - 6, middle - 2, middle, middle + 2, middle + 6];
      const data = values.join(", ");

      if (i % 3 === 0) {
        return {
          prompt: `Find the mean of this data set: ${data}.`,
          answer: String(middle),
          explanation: "Add the five values and divide the total by 5."
        };
      }

      if (i % 3 === 1) {
        return {
          prompt: `Find the median of this data set: ${data}.`,
          answer: String(middle),
          explanation: "The values are in order. The median is the middle value."
        };
      }

      return {
        prompt: `Find the range of this data set: ${data}.`,
        answer: String(values[4] - values[0]),
        explanation: `Range = largest value − smallest value = ${values[4]} − ${values[0]}.`
      };
    }

    function probabilityQuestion(i, yearNumber) {
      if (yearNumber >= 10 && i % 5 === 0) {
        const red = 3 + (i % 7);
        const blue = 5 + (i % 9);
        const total = red + blue;
        return {
          prompt: `A bag has ${red} red and ${blue} blue counters. Two are drawn without replacement. What is the probability both are red?`,
          answer: simplifyFraction(red * (red - 1), total * (total - 1)),
          explanation: `Multiply the chance of red on the first draw (${red}/${total}) by the chance on the second draw (${red - 1}/${total - 1}), then simplify.`
        };
      }

      if (yearNumber >= 9 && i % 3 === 0) {
        const target = 2 + ((i - 1) % 11);
        const successfulOutcomes = target <= 7 ? target - 1 : 13 - target;
        return {
          prompt: `Two fair dice are rolled. What is the probability their total is ${target}?`,
          answer: simplifyFraction(successfulOutcomes, 36),
          explanation: `There are ${successfulOutcomes} outcomes that make ${target}, out of 36 equally likely outcomes.`
        };
      }

      const red = 2 + (i % 9);
      const blue = 3 + ((i * 2) % 10);
      const green = 1 + ((i * 3) % 8);
      const total = red + blue + green;

      return {
        prompt: `A bag has ${red} red, ${blue} blue, and ${green} green counters. What is the probability of picking red?`,
        answer: simplifyFraction(red, total),
        explanation: `There are ${red} red counters out of ${total} counters altogether.`
      };
    }

    function makeQuestion(topic, index, yearNumber) {
      switch (topic) {
        case "Number": return numberQuestion(index, yearNumber);
        case "Algebra": return algebraQuestion(index, yearNumber);
        case "Measurement": return measurementQuestion(index, yearNumber);
        case "Space": return spaceQuestion(index, yearNumber);
        case "Statistics": return statisticsQuestion(index);
        case "Probability": return probabilityQuestion(index, yearNumber);
        default: return algebraQuestion(index, yearNumber);
      }
    }

    function showTopicPage(year, topic) {
      document.querySelector("#home-view").hidden = true;
      document.querySelector("#topic-view").hidden = false;
      document.title = `${topic} practice · Calculora`;

      document.querySelector("#topic-year").textContent = year;
      document.querySelector("#topic-title").textContent = `${topic} practice`;
      document.querySelector("#topic-intro").textContent =
        `30 ${topic.toLowerCase()} questions for ${year}. Open each answer when you’re ready.`;

      const list = document.querySelector("#topic-question-list");
      const yearNumber = Number(year.match(/\d+/)[0]);

      for (let i = 1; i <= 30; i++) {
        const question = makeQuestion(topic, i, yearNumber);
        const card = document.createElement("article");
        card.className = "topic-question";

        const number = document.createElement("p");
        number.className = "question-number";
        number.textContent = `Question ${i} of 30`;

        const prompt = document.createElement("p");
        prompt.className = "question-prompt";
        prompt.textContent = question.prompt;

        const details = document.createElement("details");
        details.className = "question-answer";

        const summary = document.createElement("summary");
        summary.textContent = "Show answer and explanation";

        const answer = document.createElement("p");
        answer.textContent = `Answer: ${question.answer} — ${question.explanation}`;

        details.append(summary, answer);
        card.append(number, prompt, details);
        list.append(card);
      }
    }

    function startHomePage() {
      let activeYear = "Year 7";
      const yearGrid = document.querySelector("#year-grid");
      const pathwayPanel = document.querySelector("#pathway-panel");

      function renderYears() {
        yearGrid.innerHTML = Object.entries(curriculum).map(([year, data]) => `
          <button
            class="year-card ${year === activeYear ? "selected" : ""}"
            style="--tint:${data.tint}"
            data-year="${year}"
            aria-pressed="${year === activeYear}"
          >
            <span class="year-tag">Calculora learning map</span>
            <h3>${year}</h3>
            <p>${data.label}. Open the six topic strands.</p>
          </button>
        `).join("");

        yearGrid.querySelectorAll("[data-year]").forEach(button => {
          button.addEventListener("click", () => {
            activeYear = button.dataset.year;
            renderYears();
            renderPathway();
          });
        });
      }

      function renderPathway() {
        const data = curriculum[activeYear];

        pathwayPanel.innerHTML = `
          <div class="panel-head">
            <div>
              <h3>${activeYear} learning map</h3>
              <p>${data.label} · Choose a topic to open its 30 practice questions.</p>
            </div>
            <span class="curriculum-tag">Six topic strands</span>
          </div>
          <div class="strand-grid">
            ${data.strands.map(([name, description], index) => `
              <a
                class="strand strand-topic-link"
                style="--tint:${data.tint}"
                href="?year=${encodeURIComponent(activeYear)}&topic=${encodeURIComponent(name)}"
              >
                <div class="strand-top">
                  <span class="strand-icon">${strandIcons[index]}</span>
                  <h4>${name}</h4>
                </div>
                <p>${description}</p>
                <span class="strand-action">
                  <span>Open 30 questions</span>
                  <span aria-hidden="true">↗</span>
                </span>
              </a>
            `).join("")}
          </div>`;
      }

      renderYears();
      renderPathway();

      const pressTrack = document.querySelector("#press-track");
      const pressToggle = document.querySelector("#press-toggle");

      pressToggle.addEventListener("click", () => {
        const paused = pressTrack.classList.toggle("paused");
        pressToggle.textContent = paused ? "Play" : "Pause";
        pressToggle.setAttribute("aria-pressed", String(paused));
      });

      const storageKey = "calculora-completed-lessons-v1";
      let completed = [];

      try {
        completed = JSON.parse(localStorage.getItem(storageKey) || "[]");
        if (!Array.isArray(completed)) completed = [];
      } catch {
        completed = [];
      }

      function updateProgress() {
        const count = completed.length;
        document.querySelector("#progress-count").textContent = count;
        document.querySelector("#progress-copy").textContent = count
          ? "Nice work. Keep going at your own pace."
          : "Start a lesson to begin building your streak.";
        document.querySelector("#progress-fill").style.width =
          `${Math.min(count * 20, 100)}%`;
      }

      updateProgress();

      document.querySelector("#mark-lesson").addEventListener("click", event => {
        const lessonId = "year7-algebra-equations";
        if (!completed.includes(lessonId)) completed.push(lessonId);
        localStorage.setItem(storageKey, JSON.stringify(completed));
        updateProgress();
        event.currentTarget.textContent = "Lesson complete ✓";
      });

      document.querySelectorAll(".answer-option").forEach(button => {
        button.addEventListener("click", () => {
          const correct = button.dataset.correct === "true";
          document.querySelectorAll(".answer-option").forEach(answer => {
            answer.classList.remove("correct", "incorrect");
          });
          button.classList.add(correct ? "correct" : "incorrect");
          document.querySelector("#quiz-feedback").textContent = correct
            ? "Correct! Subtract 4 from both sides: 2x = 10. Then divide by 2, so x = 5."
            : "Not quite. Subtract 4 from both sides, then divide by 2. Try again.";
        });
      });

      const flashcard = document.querySelector("#flashcard");
      const flashToggle = document.querySelector("#flash-toggle");
      let flashIsBack = false;

      function flipFlashcard() {
        flashIsBack = !flashIsBack;
        document.querySelector("#flash-label").textContent =
          flashIsBack ? "Flashcard · answer" : "Flashcard · front";
        document.querySelector("#flash-front").hidden = flashIsBack;
        document.querySelector("#flash-back").hidden = !flashIsBack;
      }

      flashToggle.addEventListener("click", () => {
        flashcard.hidden = !flashcard.hidden;
        if (!flashcard.hidden) {
          flashcard.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }
      });

      flashcard.addEventListener("click", flipFlashcard);
      flashcard.addEventListener("keydown", event => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          flipFlashcard();
        }
      });
    }

    const params = new URLSearchParams(window.location.search);
    const requestedYear = params.get("year");
    const requestedTopic = params.get("topic");
    const validYears = Object.keys(curriculum);
    const validTopics = ["Number", "Algebra", "Measurement", "Space", "Statistics", "Probability"];

    if (validYears.includes(requestedYear) && validTopics.includes(requestedTopic)) {
      showTopicPage(requestedYear, requestedTopic);
    } else {
      startHomePage();
    }
  </script>
</body>
</html>
