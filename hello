      "Year 11": {
        label: "Build senior maths foundations",
        tint: "#f7e5d5",
        strands: [
          ["Number", "Financial maths, rates, indices, growth, and exact values."],
          ["Algebra", "Functions, equations, rearranging expressions, and modelling."],
