<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#faf8f5">
  <meta name="description" content="Calculora is a guided maths learning path for Australian students in Years 7–12.">
  <title>Calculora — Learn maths step by step</title>

  <style>
    :root {
      --ink: #28251f;
      --muted: #766e63;
      --orange: #e87532;
      --orange-dark: #c45b24;
      --line: #e9e1d8;
      --paper: #fffefc;
      --canvas: #faf8f5;
      --cream: #fff1e5;
      --shadow: 0 20px 55px rgba(50, 36, 25, .09);
    }

    * { box-sizing: border-box; }

    [hidden] { display: none !important; }

    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      color: var(--ink);
      background: var(--canvas);
      font-family: Inter, ui-sans-serif, system-ui, -apple-system,
        BlinkMacSystemFont, "Segoe UI", sans-serif;
      line-height: 1.55;
    }

    a { color: inherit; }
    button, input { font: inherit; }
    button { cursor: pointer; }

    .shell {
      width: min(1160px, calc(100% - 44px));
      margin-inline: auto;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 5;
      background: rgba(255, 255, 255, .92);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--line);
    }

    .nav {
      min-height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 11px;
      text-decoration: none;
      font-size: 20px;
      font-weight: 850;
      letter-spacing: -.04em;
    }

    .brand-icon {
      width: 37px;
      height: 37px;
      display: grid;
      place-items: center;
      border-radius: 12px;
      background: var(--orange);
      color: white;
      font-size: 19px;
      font-weight: 900;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
      color: var(--muted);
      font-size: 14px;
      font-weight: 650;
    }

    .nav-links a,
    .footer-links a { text-decoration: none; }

    .nav-links a:hover,
    .footer-links a:hover { color: var(--orange-dark); }

    .nav-cta,
    .primary-btn {
      border: 0;
      border-radius: 11px;
      background: var(--orange);
      color: white;
      font-weight: 750;
      text-decoration: none;
      transition: .18s ease;
    }

    .nav-cta { padding: 11px 16px; font-size: 14px; }

    .nav-cta:hover,
    .primary-btn:hover {
      background: var(--orange-dark);
      transform: translateY(-1px);
    }

    .hero { padding: 64px 0 34px; }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.12fr .88fr;
      gap: 36px;
      align-items: center;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 12px;
      border: 1px solid #f1c7a9;
      border-radius: 30px;
      background: #fff3e9;
      color: #9b4c22;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .04em;
      text-transform: uppercase;
    }

    .eyebrow-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--orange);
    }

    h1 {
      max-width: 680px;
      margin: 20px 0 16px;
      font-size: clamp(42px, 6.1vw, 72px);
      line-height: .99;
      letter-spacing: -.065em;
    }

    h1 span { color: var(--orange); }

    .hero-copy {
      max-width: 590px;
      color: var(--muted);
      font-size: 18px;
    }

    .hero-actions {
      display: flex;
      align-items: center;
      gap: 13px;
      margin-top: 25px;
      flex-wrap: wrap;
    }

    .primary-btn { display: inline-block; padding: 14px 20px; }

    .text-btn {
      padding: 12px 4px;
      color: var(--ink);
      text-decoration: none;
      font-size: 14px;
      font-weight: 750;
    }

    .hero-note {
      margin-top: 17px;
      color: var(--muted);
      font-size: 12px;
    }

    .hero-art {
      min-height: 340px;
      position: relative;
      overflow: hidden;
      border-radius: 28px;
      padding: 24px;
      background: #b95727;
      box-shadow: var(--shadow);
    }

    .hero-art::before,
    .hero-art::after {
      content: "";
      position: absolute;
      border-radius: 50%;
      filter: blur(1px);
    }

    .hero-art::before {
      width: 260px;
      height: 260px;
      right: -30px;
      top: -85px;
      background: #ed9a61;
    }

    .hero-art::after {
      width: 190px;
      height: 190px;
      bottom: -74px;
      left: -42px;
      background: #d96b35;
    }

    .art-label {
      position: relative;
      z-index: 1;
      color: #fff2e8;
      font-size: 12px;
      font-weight: 750;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .math-card {
      position: absolute;
      z-index: 1;
      left: 10%;
      right: 10%;
      top: 22%;
      padding: 24px;
      border: 1px solid #ffffff35;
      border-radius: 19px;
      background: #ffffffef;
      box-shadow: 0 16px 40px #33241933;
      transform: rotate(-2deg);
    }

    .math-card small { color: var(--muted); font-weight: 750; }

    .math-equation {
      margin: 12px 0;
      font-family: Georgia, serif;
      font-size: clamp(27px, 4vw, 43px);
      letter-spacing: -.04em;
    }

    .math-equation em { color: var(--orange); font-style: normal; }

    .mini-progress {
      height: 8px;
      margin-top: 20px;
      overflow: hidden;
      border-radius: 9px;
      background: #f0e8df;
    }

    .mini-progress span {
      display: block;
      width: 68%;
      height: 100%;
      border-radius: inherit;
      background: var(--orange);
    }

    .art-foot {
      display: flex;
      justify-content: space-between;
      color: #fff0e5;
      font-size: 12px;
    }

    .section { padding: 45px 0; }

    .section-heading {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 22px;
    }

    .section-kicker {
      margin: 0 0 7px;
      color: var(--orange-dark);
      font-size: 12px;
      font-weight: 850;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    h2 {
      margin: 0;
      font-size: clamp(27px, 4vw, 39px);
      line-height: 1.1;
      letter-spacing: -.045em;
    }

    .section-desc {
      max-width: 560px;
      margin: 8px 0 0;
      color: var(--muted);
    }

    .press-strip {
      margin: 3px 0 14px;
      padding: 17px 0 15px;
      overflow: hidden;
      border-block: 1px solid var(--line);
      background: #fffdf9;
    }

    .press-inner {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 20px;
    }

    .press-intro { min-width: 205px; }
    .press-intro strong { display: block; font-size: 13px; }
    .press-intro span {
      display: block;
      margin-top: 2px;
      color: var(--muted);
      font-size: 10px;
    }

    .press-window { min-width: 0; overflow: hidden; }

    .press-track {
      display: flex;
      width: max-content;
      animation: press-drift-right 34s linear infinite;
    }

    .press-track.paused { animation-play-state: paused; }

    .press-set {
      display: flex;
      min-width: max(760px, 70vw);
      align-items: center;
      justify-content: space-around;
      gap: 42px;
      padding-inline: 18px;
    }

    .press-name {
      color: #4a443e;
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(16px, 2vw, 22px);
      font-weight: 700;
      white-space: nowrap;
    }

    .press-name.guardian {
      font-family: Georgia, serif;
      font-weight: 500;
      letter-spacing: -.05em;
    }

    .press-name.smh {
      font-family: Georgia, serif;
      font-size: clamp(14px, 1.7vw, 18px);
    }

    .press-control {
      padding: 7px 10px;
      border: 1px solid var(--line);
      border-radius: 9px;
      background: white;
      color: var(--muted);
      font-size: 11px;
      font-weight: 750;
    }

    @keyframes press-drift-right {
      from { transform: translateX(-50%); }
      to { transform: translateX(0); }
    }

    .progress-card {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 19px;
      align-items: center;
      padding: 22px 25px;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: var(--paper);
      box-shadow: 0 8px 24px #33241908;
    }

    .progress-icon {
      width: 48px;
      height: 48px;
      display: grid;
      place-items: center;
      border-radius: 15px;
      background: #f5e3b9;
      font-size: 22px;
    }

    .progress-title { margin: 0 0 3px; font-weight: 800; }
    .progress-sub { margin: 0; color: var(--muted); font-size: 13px; }
    .progress-number { color: var(--orange-dark); font-size: 20px; font-weight: 850; }

    .progress-bar {
      height: 7px;
      margin-top: 10px;
      overflow: hidden;
      border-radius: 7px;
      background: #f0e8df;
    }

    .progress-bar span {
      display: block;
      width: 0;
      height: 100%;
      border-radius: inherit;
      background: var(--orange);
      transition: width .3s ease;
    }

    .year-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
    }

    .year-card {
      position: relative;
      overflow: hidden;
      min-height: 165px;
      padding: 20px;
      border: 1px solid var(--line);
      border-radius: 17px;
      background: var(--paper);
      text-align: left;
      transition: transform .18s ease, box-shadow .18s ease;
    }

    .year-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }

    .year-card.selected {
      border-color: var(--orange);
      box-shadow: 0 0 0 3px #e8753218;
    }

    .year-card::after {
      content: attr(data-symbol);
      position: absolute;
      right: 12px;
      bottom: -24px;
      color: var(--tint);
      font-size: 110px;
      font-weight: 900;
      line-height: 1;
      opacity: .55;
    }

    .year-card > * { position: relative; z-index: 1; }

    .year-tag {
      color: var(--muted);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .year-card h3 { margin: 12px 0 6px; font-size: 23px; }
    .year-card p { max-width: 220px; margin: 0; color: var(--muted); font-size: 13px; }

    .pathway-panel {
      margin-top: 20px;
      padding: 25px;
      border: 1px solid var(--line);
      border-radius: 19px;
      background: var(--paper);
    }

    .panel-head {
      display: flex;
      align-items: start;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 19px;
    }

    .panel-head h3 { margin: 0; font-size: 22px; }
    .panel-head p { margin: 5px 0 0; color: var(--muted); font-size: 14px; }

    .curriculum-tag {
      padding: 7px 10px;
      border-radius: 9px;
      background: var(--cream);
      color: #9b4c22;
      font-size: 11px;
      font-weight: 800;
      white-space: nowrap;
    }

    .strand-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .strand {
      padding: 15px;
      border: 1px solid var(--line);
      border-radius: 13px;
      background: #fdfaf6;
    }

    .strand-top {
      display: flex;
      align-items: center;
      gap: 9px;
      margin-bottom: 7px;
    }

    .strand-icon {
      width: 28px;
      height: 28px;
      display: grid;
      place-items: center;
      border-radius: 9px;
      background: var(--tint);
      font-size: 14px;
    }

    .strand h4 { margin: 0; font-size: 14px; }
    .strand p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.5; }

    .strand-topic-link {
      display: block;
      color: inherit;
      text-decoration: none;
      transition: transform .18s ease, border-color .18s ease;
    }

    .strand-topic-link:hover {
      transform: translateY(-2px);
      border-color: var(--orange);
    }

    .strand-topic-link:focus-visible {
      outline: 3px solid var(--orange);
      outline-offset: 2px;
    }

    .strand-action {
      display: flex;
      justify-content: space-between;
      margin-top: 12px;
      color: var(--orange-dark);
      font-size: 11px;
      font-weight: 800;
    }

    .senior-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 13px;
    }

    .senior-card {
      display: flex;
      min-height: 194px;
      flex-direction: column;
      padding: 19px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--paper);
    }

    .senior-card .stage {
      color: var(--orange-dark);
      font-size: 11px;
      font-weight: 850;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .senior-card h3 { margin: 10px 0 7px; font-size: 17px; }
    .senior-card p { flex: 1; margin: 0; color: var(--muted); font-size: 13px; }
    .senior-card a { margin-top: 15px; color: var(--orange-dark); font-size: 12px; font-weight: 800; text-decoration: none; }

    .features {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }

    .feature {
      display: flex;
      gap: 15px;
      padding: 20px;
      border: 1px solid var(--line);
      border-radius: 16px;
      background: var(--paper);
    }

    .feature-icon {
      flex: 0 0 42px;
      height: 42px;
      display: grid;
      place-items: center;
      border-radius: 13px;
      background: var(--tint);
      font-size: 18px;
    }

    .feature h3 { margin: 1px 0 5px; font-size: 16px; }
    .feature p { margin: 0; color: var(--muted); font-size: 13px; }

    .lesson-demo {
      display: grid;
      grid-template-columns: 1fr .84fr;
      gap: 22px;
      align-items: stretch;
    }

    .lesson-card {
      padding: 27px;
      border-radius: 20px;
      background: var(--ink);
      color: white;
    }

    .lesson-card .section-kicker { color: #f6c49f; }
    .lesson-card h2 { color: white; font-size: 29px; }
    .lesson-card p { color: #e5ddd5; }

    .example {
      margin-top: 20px;
      padding: 16px;
      border: 1px solid #ffffff20;
      border-radius: 12px;
      background: #ffffff0b;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    .example strong { color: #f5e3b9; }

    .quiz-card {
      padding: 25px;
      border: 1px solid var(--line);
      border-radius: 20px;
      background: var(--paper);
    }

    .quiz-card h3 { margin: 0 0 7px; font-size: 19px; }
    .quiz-question { margin: 0 0 15px; color: var(--muted); font-size: 14px; }
    .answer-list { display: grid; gap: 9px; }

    .answer-option {
      padding: 11px 13px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: white;
      color: var(--ink);
      text-align: left;
    }

    .answer-option:hover { border-color: var(--orange); background: #fff8f1; }
    .answer-option.correct { border-color: #61b58e; background: #ecfaf3; }
    .answer-option.incorrect { border-color: #e0a093; background: #fff3ef; }

    #quiz-feedback {
      min-height: 24px;
      margin: 12px 0 0;
      color: var(--muted);
      font-size: 13px;
    }

    .flashcard-area {
      display: flex;
      min-height: 180px;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 20px;
      border: 1px solid var(--line);
      border-radius: 15px;
      background: #fcfaf7;
      text-align: center;
      cursor: pointer;
    }

    .flashcard-area small {
      color: var(--orange-dark);
      font-weight: 850;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .flashcard-area strong { margin-top: 9px; font-size: 20px; }
    .flashcard-area span { margin-top: 8px; color: var(--muted); font-size: 13px; }

    .flash-controls {
      display: flex;
      justify-content: space-between;
      gap: 8px;
      margin-top: 12px;
    }

    .soft-btn {
      padding: 9px 12px;
      border: 1px solid var(--line);
      border-radius: 9px;
      background: white;
      color: var(--ink);
      font-size: 12px;
      font-weight: 750;
    }

    .soft-btn:hover { border-color: var(--orange); color: var(--orange-dark); }

    .pricing-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
    }

    .pricing-card {
      position: relative;
      display: flex;
      min-height: 330px;
      flex-direction: column;
      padding: 22px 19px;
      border: 1px solid var(--line);
      border-radius: 17px;
      background: var(--paper);
    }

    .pricing-card.featured {
      border: 2px solid var(--orange);
      box-shadow: 0 12px 30px #e8753217;
    }

    .plan-badge {
      position: absolute;
      top: -12px;
      right: 16px;
      padding: 4px 9px;
      border-radius: 20px;
      background: var(--orange);
      color: white;
      font-size: 10px;
      font-weight: 850;
      text-transform: uppercase;
    }

    .plan-name { margin: 0; font-size: 17px; font-weight: 850; }

    .plan-price {
      margin: 13px 0 3px;
      font-size: 31px;
      font-weight: 850;
      letter-spacing: -.05em;
      line-height: 1.1;
    }

    .plan-price small {
      color: var(--muted);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0;
    }

    .plan-caption { min-height: 38px; margin: 0; color: var(--muted); font-size: 12px; }

    .plan-features {
      display: grid;
      gap: 9px;
      margin: 18px 0 20px;
      padding: 0;
      list-style: none;
      color: #514b44;
      font-size: 12px;
    }

    .plan-features li::before {
      content: "✓";
      margin-right: 8px;
      color: var(--orange-dark);
      font-weight: 900;
    }

    .plan-link {
      display: block;
      margin-top: auto;
      padding: 10px 12px;
      border: 1px solid var(--line);
      border-radius: 10px;
      text-align: center;
      text-decoration: none;
      font-size: 12px;
      font-weight: 800;
    }

    .featured .plan-link {
      border-color: var(--orange);
      background: var(--orange);
      color: white;
    }

    .pricing-note { margin: 12px 0 0; color: var(--muted); font-size: 11px; }

    .source-note {
      margin-top: 20px;
      padding: 15px 17px;
      border-radius: 12px;
      background: var(--cream);
      color: #55473d;
      font-size: 12px;
    }

    .source-note a { color: #9b4c22; font-weight: 750; }

    .footer {
      margin-top: 45px;
      padding: 27px 0;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 12px;
    }

    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
    }

    .footer-links { display: flex; gap: 18px; }

    .footer-links a {
      color: var(--ink);
      font-size: 16px;
      font-weight: 800;
    }

    .notice { color: #766e63; }

    /* The topic practice view */
    .topic-topbar {
      padding: 20px 0;
      border-bottom: 1px solid var(--line);
      background: var(--paper);
    }

    .back-link {
      color: var(--orange-dark);
      font-size: 14px;
      font-weight: 800;
      text-decoration: none;
    }

    .topic-main { padding: 38px 0 60px; }

    .topic-question-list { display: grid; gap: 12px; }

    .topic-question {
      padding: 18px 20px;
      border: 1px solid var(--line);
      border-radius: 15px;
      background: var(--paper);
    }

    .question-number {
      margin: 0 0 7px;
      color: var(--orange-dark);
      font-size: 11px;
      font-weight: 850;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .question-prompt { margin: 0; font-size: 16px; font-weight: 700; }

    .question-answer {
      margin-top: 12px;
      padding-top: 10px;
      border-top: 1px solid var(--line);
    }

    .question-answer summary {
      color: var(--orange-dark);
      cursor: pointer;
      font-size: 13px;
      font-weight: 800;
    }

    .question-answer p { margin: 9px 0 0; color: var(--muted); font-size: 14px; }

    @media (max-width: 850px) {
      .hero-grid { grid-template-columns: 1fr .8fr; gap: 22px; }
      .year-grid, .pricing-grid { grid-template-columns: repeat(2, 1fr); }
      .senior-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @media (max-width: 640px) {
      .shell { width: min(100% - 28px, 540px); }
      .nav { min-height: 66px; }
      .nav-links { gap: 13px; font-size: 12px; }
      .nav-links a:nth-child(2) { display: none; }
      .nav-cta { padding: 9px 11px; }
      .hero { padding-top: 43px; }
      .hero-grid, .lesson-demo { grid-template-columns: 1fr; }
      .hero-art { min-height: 280px; }
      .math-card { top: 20%; }
      .section { padding: 34px 0; }
      .section-heading { align-items: start; flex-direction: column; }
      .progress-card { grid-template-columns: auto 1fr; padding: 17px; }
